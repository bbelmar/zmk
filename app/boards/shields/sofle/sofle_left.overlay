/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <12>;   // try 12 → 8 if still too “slippery”
    };
};

&left_encoder {
    status = "okay";
    // Optional but recommended if not set in sofle.dtsi:
    // a-gpios = <&pro_micro PIN_A (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    // b-gpios = <&pro_micro PIN_B (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
};
